{
  "name": "brothers-royale",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BROTHERS ROYALE — Battle Royale web low poly isométrico (móvil y PC).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && npm run build:server",
    "build:pages": "tsc --noEmit && vite build --outDir jugar --emptyOutDir",
    "build:server": "vite build -c vite.server.config.ts",
    "server": "npm run build:server && node dist-server/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.30",
    "@colyseus/schema": "^5.0.52",
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.5",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
