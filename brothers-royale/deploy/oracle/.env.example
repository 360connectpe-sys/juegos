# Copiar a .env y completar. NO subir .env al repositorio.
# Dominio público de la VM. Sin dominio propio, usa la IP con sslip.io: 203.0.113.7 → 203-0-113-7.sslip.io
DOMAIN=203-0-113-7.sslip.io
# Orígenes web permitidos (separados por comas).
ALLOWED_ORIGINS=https://360connectpe-sys.github.io
# Salas simultáneas (8 jugadores cada una). 6 cabe holgado en 1 OCPU Ampere.
MAX_ROOMS=6
