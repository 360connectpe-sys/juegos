# Copia este archivo como .env solo como referencia: el servidor lee process.env directamente
# (Render y Railway te dejan poner estas variables en su panel).

# Puerto: Render y Railway lo asignan solos. En tu computadora se usa 3000.
PORT=3000

# Tiempos en milisegundos (opcional; estos son los valores por defecto)
MOVE_MS=15000
AIM_MS=20000
RESOLUTION_MS=1800
START_DELAY_MS=2500
RECONNECT_MS=30000
EMPTY_ROOM_MS=60000

# Solo si sirves el juego desde otro dominio distinto al del servidor (separados por coma)
# CORS_ORIGIN=https://360connectpe-sys.github.io
